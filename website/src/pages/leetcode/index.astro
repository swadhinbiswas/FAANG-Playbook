---
import Layout from '../../layouts/Layout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { parse } from 'csv-parse/sync';

// Company aliases (canonical slug from CSVs -> preferred URL slug)
const COMPANY_ALIASES: Record<string, string> = {
  meta: 'facebook',
  fb: 'facebook',
};
const COMPANY_DISPLAY_OVERRIDES: Record<string, string> = {
  facebook: 'Meta',
};

interface Problem {
  id: number;
  title: string;
  acceptance: string;
  difficulty: 'Easy' | 'Medium' | 'Hard';
  frequency: number;
  url: string;
}

function parseCSV(filepath: string): Problem[] {
  if (!existsSync(filepath)) return [];
  try {
    const content = readFileSync(filepath, 'utf-8');
    const records = parse(content, {
      skip_empty_lines: true,
      relax_column_count: true,
      trim: true,
    });
    return records
      .filter((r: any[]) => r.length >= 5)
      .map((r: any[]) => ({
        id: parseInt(r[0], 10),
        title: r[1]?.trim() || '',
        acceptance: r[2]?.trim() || '0%',
        difficulty: (['Easy', 'Medium', 'Hard'].includes(r[3]) ? r[3] : 'Medium') as 'Easy' | 'Medium' | 'Hard',
        frequency: parseFloat(r[4]) || 0,
        url: r[5]?.trim() || `https://leetcode.com/problems/${r[0]}`,
      }))
      .filter((p: Problem) => !isNaN(p.id));
  } catch {
    return [];
  }
}

const CSV_DIR = join(process.cwd(), '..', 'leetcode Question ');

interface CompanyAnalysis {
  total: number;
  easy: number;
  medium: number;
  hard: number;
  repeat: number;
  avgAcceptance: number;
}

const analysisCache: Record<string, CompanyAnalysis> = {};

function analyzeCompany(name: string): CompanyAnalysis {
  if (analysisCache[name]) return analysisCache[name];
  const timeframes: Problem[][] = [];
  for (const suffix of ['6months', '1year', '2year', 'alltime']) {
    const problems = parseCSV(join(CSV_DIR, `${name}_${suffix}.csv`));
    if (problems.length > 0) timeframes.push(problems);
  }
  const all = timeframes.flat();
  const unique = [...new Map(all.map(p => [p.id, p])).values()];
  const tfCounts: Record<number, number> = {};
  for (const t of timeframes) for (const p of t) tfCounts[p.id] = (tfCounts[p.id] || 0) + 1;
  const maxTf = Math.max(1, timeframes.length);
  const result: CompanyAnalysis = {
    total: unique.length,
    easy: unique.filter(p => p.difficulty === 'Easy').length,
    medium: unique.filter(p => p.difficulty === 'Medium').length,
    hard: unique.filter(p => p.difficulty === 'Hard').length,
    repeat: unique.filter(p => (tfCounts[p.id] || 1) === maxTf).length,
    avgAcceptance: unique.length
      ? Math.round(unique.reduce((s, p) => s + (parseFloat(p.acceptance) || 0), 0) / unique.length)
      : 0,
  };
  analysisCache[name] = result;
  return result;
}

function companyHref(name: string): string {
  for (const [alias, target] of Object.entries(COMPANY_ALIASES)) {
    if (target === name) return `/leetcode/${alias}`;
  }
  return `/leetcode/${name}`;
}

function companyDisplay(name: string, jsonDisplay: string): string {
  return COMPANY_DISPLAY_OVERRIDES[name] ?? jsonDisplay;
}

function diffPct(a: CompanyAnalysis, n: number): number {
  return a.total ? Math.round((n / a.total) * 100) : 0;
}

