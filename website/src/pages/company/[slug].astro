// Companies without a LeetCode dataset yet -> link to the directory instead
const LECOMPANY_LEETCODE_MISSING = new Set(["coinbase", "snowflake", "stripe"]);
const leetcodeHref = (s: string) =>
  LECOMPANY_LEETCODE_MISSING.has(s) ? "/leetcode" : `/leetcode/${s}`;

export async function getStaticPaths() {
  const companies = [
    { slug: "google", name: "Google" },
    { slug: "meta", name: "Meta" },
    { slug: "amazon", name: "Amazon" },
    { slug: "apple", name: "Apple" },
    { slug: "microsoft", name: "Microsoft" },
    { slug: "netflix", name: "Netflix" },
    { slug: "stripe", name: "Stripe" },
    { slug: "uber", name: "Uber" },
    { slug: "airbnb", name: "Airbnb" },
    { slug: "linkedin", name: "LinkedIn" },
    { slug: "twitter", name: "Twitter" },
    { slug: "spotify", name: "Spotify" },
    { slug: "salesforce", name: "Salesforce" },
    { slug: "adobe", name: "Adobe" },
    { slug: "oracle", name: "Oracle" },
    { slug: "nvidia", name: "Nvidia" },
    { slug: "intel", name: "Intel" },
    { slug: "databricks", name: "Databricks" },
    { slug: "snowflake", name: "Snowflake" },
    { slug: "coinbase", name: "Coinbase" },
  ];

  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { slug: company.slug, company },
  }));
}

