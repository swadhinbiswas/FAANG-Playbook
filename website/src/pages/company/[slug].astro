  snowflake: {
    fullName: "Snowflake",
    color: "#29B5E8",
    levels: "L1-L5 (SWE, Data)",
    culture: "Innovation, customer success, transparency",
    loopStructure: [
      { stage: "Phone Screen", duration: "60 min", focus: "Coding + SQL" },
      { stage: "Onsite", duration: "4 rounds", focus: "Coding + Design + SQL + Behavioral" },
    ],
    codingFocus: ["Arrays", "Strings", "SQL", "Data Structures"],
    systemDesignPrompts: ["Design Data Warehouse", "Design Query Optimizer", "Design Storage System", "Design Multi-Cloud"],
    behavioralFocus: ["Customer success", "Innovation", "Transparency"],
    topProblems: [
      { name: "Database normalization", difficulty: "Medium", pattern: "SQL" },
      { name: "Window Functions", difficulty: "Medium", pattern: "SQL" },
      { name: "Query Optimization", difficulty: "Hard", pattern: "SQL" },
    ],
    tips: [
      "Strong SQL skills required",
      "Understand data warehousing",
      "Think about cloud architecture",
      "Show customer obsession",
    ],
    resources: [
      { title: "SQL Interview Guide", href: "/docs/interviews/05-SQL-Data-Interview" },
      { title: "Data Modeling", href: "/docs/data/02-Data-Modeling" },
    ],
  },
  coinbase: {
    fullName: "Coinbase",
    color: "#0052FF",
    levels: "L1-L5 (SWE, Crypto)",
    culture: "Clear communication, efficient execution, continuous learning",
    loopStructure: [
      { stage: "Phone Screen", duration: "60 min", focus: "Coding" },
      { stage: "Onsite", duration: "4 rounds", focus: "Coding + Design + Domain + Behavioral" },
    ],
    codingFocus: ["Arrays", "Strings", "Trees", "Cryptography basics"],
    systemDesignPrompts: ["Design Exchange", "Design Wallet", "Design Blockchain", "Design Payment System"],
    behavioralFocus: ["Crypto passion", "Clear communication", "Efficient execution"],
    topProblems: [
      { name: "Decode Ways", difficulty: "Medium", pattern: "DP" },
      { name: "Validate Binary Tree", difficulty: "Medium", pattern: "Tree" },
      { name: "Design HashMap", difficulty: "Easy", pattern: "Design" },
    ],
    tips: [
      "Show genuine interest in crypto",
      "Understand blockchain basics",
      "Think about security first",
      "Communicate clearly and efficiently",
    ],
    resources: [
      { title: "System Design Guide", href: "/docs/interviews/03-System-Design-Interview-Playbook" },
    ],
  },
};

const data = companyData[slug] || companyData.google;
const pageTitle = `${company.name} Interview Prep 2026-2027`;
const pageDescription = `Complete interview preparation guide for ${company.name}. Master coding, system design, and behavioral interviews with company-specific questions, tips, and resources.`;
---

<Layout title={pageTitle} activeSection="company-prep">
  <div class="company-page">
    <!-- Company Header -->
    <header class="company-header" style={`background: linear-gradient(135deg, ${companyColor}22 0%, ${companyColor}05 100%)`}>
      <div class="company-hero">
        <div class="company-logo" style={`background: ${companyColor}`}>
          <Fragment set:html={companyIcon} />
        </div>
        <div class="company-info">
          <h1>{company.name} Interview Prep</h1>
          <p class="company-levels">
            <span class="nf">📊</span> Levels: {data.levels}
          </p>
          <p class="company-culture">
            <span class="nf">🎯</span> Culture: {data.culture}
          </p>
        </div>
      </div>
    </header>

    <div class="company-content">
      <!-- Interview Loop -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">🔄</span> Interview Loop Structure
        </h2>
        <div class="loop-timeline">
          {data.loopStructure.map((stage: any, idx: number) => (
            <div class="loop-stage">
              <div class="stage-marker">{idx + 1}</div>
              <div class="stage-content">
                <h3>{stage.stage}</h3>
                <div class="stage-meta">
                  <span class="duration"><span class="nf">⏱</span> {stage.duration}</span>
                  <span class="focus"><span class="nf">🎯</span> {stage.focus}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Coding Focus -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">💻</span> Coding Focus Areas
        </h2>
        <div class="focus-grid">
          {data.codingFocus.map((topic: string) => (
            <div class="focus-card">
              <span class="nf">✓</span>
              {topic}
            </div>
          ))}
        </div>
      </section>

      <!-- Top LeetCode Problems -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">🔥</span> Top LeetCode Problems
          <a href={leetcodeHref(slug)} class="view-all-link">
            View all problems →
          </a>
        </h2>
        <div class="problems-table">
          <div class="problems-header">
            <span>Problem Name</span>
            <span>Difficulty</span>
            <span>Pattern</span>
          </div>
          {data.topProblems.map((problem: any) => (
            <a 
              href={`https://leetcode.com/problems/${problem.name.toLowerCase().replace(/\s+/g, '-')}/`}
              target="_blank"
              rel="noopener"
              class="problem-row"
            >
              <span class="problem-name">{problem.name}</span>
              <span class={`difficulty ${problem.difficulty.toLowerCase()}`}>{problem.difficulty}</span>
              <span class="pattern">{problem.pattern}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- System Design Prompts -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">🏗</span> Common System Design Prompts
        </h2>
        <div class="prompts-list">
          {data.systemDesignPrompts.map((prompt: string) => (
            <div class="prompt-item">
              <span class="nf">▸</span>
              {prompt}
            </div>
          ))}
        </div>
      </section>

      <!-- Behavioral Focus -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">🎭</span> Behavioral Focus
        </h2>
        <div class="behavioral-tags">
          {data.behavioralFocus.map((focus: string) => (
            <span class="behavioral-tag">{focus}</span>
          ))}
        </div>
      </section>

      <!-- Pro Tips -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">💡</span> Pro Tips for {data.fullName}
        </h2>
        <div class="tips-grid">
          {data.tips.map((tip: string) => (
            <div class="tip-card">
              <span class="nf">⭐</span>
              {tip}
            </div>
          ))}
        </div>
      </section>

      <!-- Resources -->
      <section class="company-section">
        <h2 class="section-title">
          <span class="nf">📚</span> Recommended Resources
        </h2>
        <div class="resources-list">
          {data.resources.map((resource: any) => (
            <a href={resource.href} class="resource-link">
              <span class="nf">📖</span>
              {resource.title}
              <span class="nf arrow">→</span>
            </a>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="company-cta">
        <h2>Ready to Start Your Preparation?</h2>
        <div class="cta-actions">
          <a href={leetcodeHref(slug)} class="btn btn-primary">
            <span class="nf">👨‍💻</span>
            Practice LeetCode Problems
          </a>
          <a href="/docs/start-here/00-README" class="btn btn-secondary">
            <span class="nf">📖</span>
            View Study Roadmap
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .company-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl);
  }

  .company-header {
    border-radius: 12px;
    padding: var(--spacing-2xl);
    margin-bottom: var(--spacing-xl);
    border: 1px solid var(--surface0);
  }

  .company-hero {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
  }

  .company-logo {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    padding: 12px;
  }

  .company-logo svg {
    width: 100%;
    height: 100%;
  }

  .company-info h1 {
    font-size: 2em;
    margin-bottom: var(--spacing-sm);
    color: var(--text);
  }

  .company-levels,
  .company-culture {
    color: var(--subtext1);
    font-size: 0.95em;
    margin: var(--spacing-xs) 0;
    display: flex;
    align-items: center;
    gap: 0.5ch;
  }

  .company-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .company-section {
    background: var(--mantle);
    border: 1px solid var(--surface0);
    border-radius: 12px;
    padding: var(--spacing-lg);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.75ch;
    font-size: 1.3em;
    color: var(--text);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--surface0);
  }

  .section-title .nf {
    font-size: 1.2em;
  }

  .view-all-link {
    margin-left: auto;
    font-size: 0.85em;
    color: var(--accent-blue);
  }

  /* Loop Timeline */
  .loop-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .loop-stage {
    display: flex;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background: var(--crust);
    border-radius: 8px;
    border: 1px solid var(--surface0);
  }

  .stage-marker {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-green);
    color: var(--crust);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    flex-shrink: 0;
  }

  .stage-content h3 {
    color: var(--text);
    font-size: 1.05em;
    margin-bottom: var(--spacing-xs);
  }

  .stage-meta {
    display: flex;
    gap: var(--spacing-md);
    font-size: 0.85em;
    color: var(--subtext1);
  }

  .stage-meta .duration,
  .stage-meta .focus {
    display: flex;
    align-items: center;
    gap: 0.5ch;
  }

  /* Focus Grid */
  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--spacing-sm);
  }

  .focus-card {
    display: flex;
    align-items: center;
    gap: 0.75ch;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    font-size: 0.9em;
  }

  .focus-card .nf {
    color: var(--accent-green);
  }

  /* Problems Table */
  .problems-table {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .problems-header {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--surface0);
    border-radius: 6px;
    font-size: 0.85em;
    font-weight: bold;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .problem-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    text-decoration: none;
    transition: all var(--transition-fast);
    font-size: 0.9em;
  }

  .problem-row:hover {
    border-color: var(--accent-blue);
    background: var(--surface0);
    text-decoration: none;
  }

  .problem-name {
    color: var(--text);
    font-weight: 500;
  }

  .difficulty {
    padding: 0.15em 0.6em;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: bold;
    text-align: center;
    width: fit-content;
  }

  .difficulty.easy {
    background: rgba(166, 227, 161, 0.2);
    color: var(--green);
  }

  .difficulty.medium {
    background: rgba(250, 179, 135, 0.2);
    color: var(--peach);
  }

  .difficulty.hard {
    background: rgba(243, 139, 168, 0.2);
    color: var(--red);
  }

  .pattern {
    color: var(--subtext0);
  }

  /* Prompts List */
  .prompts-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .prompt-item {
    display: flex;
    align-items: center;
    gap: 0.75ch;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    font-size: 0.95em;
  }

  .prompt-item .nf {
    color: var(--accent-blue);
  }

  /* Behavioral Tags */
  .behavioral-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .behavioral-tag {
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    font-size: 0.9em;
    font-weight: 500;
  }

  /* Tips Grid */
  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: var(--spacing-sm);
  }

  .tip-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75ch;
    padding: var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    font-size: 0.9em;
    line-height: 1.5;
  }

  .tip-card .nf {
    color: var(--accent-yellow);
    flex-shrink: 0;
  }

  /* Resources */
  .resources-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .resource-link {
    display: flex;
    align-items: center;
    gap: 0.75ch;
    padding: var(--spacing-md);
    background: var(--crust);
    border: 1px solid var(--surface0);
    border-radius: 6px;
    color: var(--subtext1);
    text-decoration: none;
    transition: all var(--transition-fast);
    font-size: 0.95em;
  }

  .resource-link:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
    text-decoration: none;
    transform: translateX(4px);
  }

  .resource-link .arrow {
    margin-left: auto;
    color: var(--accent-green);
  }

  /* CTA Section */
  .company-cta {
    text-align: center;
    padding: var(--spacing-2xl);
    background: linear-gradient(135deg, var(--surface0) 0%, var(--mantle) 100%);
    border: 1px solid var(--surface1);
    border-radius: 12px;
  }

  .company-cta h2 {
    color: var(--text);
    font-size: 1.5em;
    margin-bottom: var(--spacing-lg);
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75ch;
    padding: var(--spacing-md) var(--spacing-xl);
    border-radius: 8px;
    font-weight: bold;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background: var(--accent-green);
    color: var(--crust);
  }

  .btn-primary:hover {
    background: var(--green);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(166, 227, 161, 0.3);
    text-decoration: none;
  }

  .btn-secondary {
    background: var(--surface0);
    color: var(--text);
    border: 1px solid var(--surface1);
  }

  .btn-secondary:hover {
    background: var(--surface1);
    transform: translateY(-2px);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .company-hero {
      flex-direction: column;
      text-align: center;
    }

    .company-info h1 {
      font-size: 1.5em;
    }

    .problems-header,
    .problem-row {
      grid-template-columns: 1.5fr 0.8fr 0.8fr;
      font-size: 0.8em;
    }

    .cta-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
