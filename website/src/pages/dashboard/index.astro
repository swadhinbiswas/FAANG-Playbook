</style>

<script>
  import { loadFromStorage, saveToStorage, STORAGE_KEYS } from "../../lib/user-data";

  interface ProgressData {
    totalTopicsCompleted: number;
    studyStreak: number;
    totalStudyTime: number;
    achievements: any[];
    topicsBySection: Record<string, number>;
    sessionsLog: any[];
    roleRoadmapDone?: number;
    weeklyGoal?: number;
  }

  function loadDashboard() {
    const progress = loadFromStorage<ProgressData>(STORAGE_KEYS.PROGRESS) || {
      totalTopicsCompleted: 0,
      studyStreak: 0,
      totalStudyTime: 0,
      achievements: [],
      topicsBySection: {},
      sessionsLog: [],
    };

    // Merge interactive-roadmap completions into the topic count
    const roleRoadmapDone = progress.roleRoadmapDone || 0;
    const mergedTopics = progress.totalTopicsCompleted - roleRoadmapDone + ROADMAP_DONE;
    const mergedTime = progress.totalStudyTime;
    const applications = loadFromStorage<any[]>(STORAGE_KEYS.APPLICATIONS) || [];

    // Study days: merge interactive-roadmap activity with logged sessions
    const studyDates = loadStudyDates(progress);
    const computedStreak = computeStreak(studyDates);
    const mergedStreak = computedStreak;
    if (mergedStreak !== progress.studyStreak) {
      progress.studyStreak = mergedStreak;
      saveToStorage(STORAGE_KEYS.PROGRESS, progress);
    }

    // Update stat cards with animation
    animateValue('total-completed', 0, mergedTopics, 1000);
    animateValue('study-streak', 0, mergedStreak, 1000);
    document.getElementById('header-streak')!.textContent = mergedStreak.toString();
    document.getElementById('total-time')!.textContent = formatTime(mergedTime);
    const leetcodeStats = loadLeetCodeProgress();
    animateValue('problems-solved', 0, leetcodeStats.solved, 1000);
    const unlocked = computeUnlocked(mergedTopics, mergedStreak, mergedTime, applications.length, leetcodeStats.solved);
    document.getElementById('achievements-count')!.textContent = unlocked.length.toString();
    document.getElementById('unlocked-count')!.textContent = unlocked.length.toString();

    // Update section progress
    updateSectionProgress(progress.topicsBySection);

    // Update activity calendar + streak chart (fed by study dates)
    updateActivityCalendar(studyDates);
    renderStreakChart(studyDates);

    // Update recent activity
    updateRecentActivity(progress.sessionsLog);

    // Update achievements (computed live from real data)
    updateAchievements(unlocked);

    // Next actions fed by the roadmap audit
    renderNextActions();

    // Weekly digest (topics/study days vs last week)
    renderWeeklyDigest();

    // LeetCode solved progress + backup status
    renderLeetCodeProgress(leetcodeStats);
    renderBackupStatus();
  }

  function loadLeetCodeProgress(): { solved: number; byCompany: Record<string, number> } {
    const byCompany: Record<string, number> = {};
    let solved = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (!key || !key.startsWith('leetcode-')) continue;
        if (localStorage.getItem(key) !== 'true') continue;
        solved++;
        const parts = key.split('-');
        parts.shift(); // 'leetcode'
        const company = parts.join('-');
        byCompany[company] = (byCompany[company] || 0) + 1;
      }
    } catch { /* ignore */ }
    return { solved, byCompany };
  }

  function loadStudyDates(progress: ProgressData): string[] {
    const dateSet = new Set<string>();
    try {
      const rmDays = JSON.parse(localStorage.getItem('rm-activity') || '[]');
      rmDays.forEach((d: string) => d && dateSet.add(d));
    } catch { /* ignore */ }
    (progress.sessionsLog || []).forEach((s: any) => s?.date && dateSet.add(s.date));
    if (progress.lastStudyDate) dateSet.add(progress.lastStudyDate);

    // Seed a fair start for existing users who have roadmap progress but no
    // recorded study days (e.g. they used the older checkbox system)
    if (dateSet.size === 0 && hasAnyRoadmapProgress()) {
      dateSet.add(new Date().toISOString().split('T')[0]);
    }
    return Array.from(dateSet).sort();
  }

  function hasAnyRoadmapProgress(): boolean {
    try {
      const all = JSON.parse(localStorage.getItem('rm-progress') || '{}');
      for (const roleState of Object.values(all) as Record<string, string>[]) {
        if (!roleState || typeof roleState !== 'object') continue;
        for (const v of Object.values(roleState)) if (v === 'done' || v === 'doing') return true;
      }
    } catch { /* ignore */ }
    return false;
  }

  function computeStreak(dates: string[]): number {
    if (dates.length === 0) return 0;
    const set = new Set(dates);
    const dayMs = 86400000;
    const start = new Date();
    start.setHours(0, 0, 0, 0);
    let streak = 0;
    let cursor = start;
    if (!set.has(start.toISOString().split('T')[0])) {
      cursor = new Date(start.getTime() - dayMs);
    }
    while (set.has(cursor.toISOString().split('T')[0])) {
      streak++;
      cursor = new Date(cursor.getTime() - dayMs);
    }
    return streak;
  }

  function computeUnlocked(topics: number, streak: number, time: number, apps: number, problems = 0): string[] {
    const unlocked: string[] = [];
    if (topics >= 1) unlocked.push('first-topic');
    if (topics >= 10) unlocked.push('10-topics');
    if (topics >= 25) unlocked.push('25-topics');
    if (topics >= 50) unlocked.push('50-topics');
    if (streak >= 7) unlocked.push('week-streak');
    if (streak >= 30) unlocked.push('month-streak');
    if (time >= 6000) unlocked.push('100-hours');
    if (apps >= 1) unlocked.push('first-app');
    if (problems >= 10) unlocked.push('10-problems');
    if (problems >= 25) unlocked.push('25-problems');
    if (problems >= 50) unlocked.push('50-problems');
    if (problems >= 100) unlocked.push('100-problems');
    return unlocked;
  }

  function formatTime(minutes: number): string {
    const hours = Math.floor(minutes / 60);
    const mins = minutes % 60;
    if (hours === 0) return `${mins}h`;
    if (mins === 0) return `${hours}h`;
    return `${hours}h ${mins}m`;
  }

  function animateValue(id: string, start: number, end: number, duration: number) {
    const element = document.getElementById(id);
    if (!element) return;
    
    const range = end - start;
    const startTime = performance.now();
    
    function update(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const value = Math.floor(start + (range * progress));
      element.textContent = value.toString();
      
      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }
    
    requestAnimationFrame(update);
  }

  let ROADMAP_DONE = 0;
  let ROADMAP_TOTAL = 0;

  function updateSectionProgress(topicsBySection: Record<string, number>) {
    const container = document.getElementById('section-progress-chart');
    const insightsContainer = document.getElementById('progress-insights');
    if (!container) return;

    const sections: Record<string, { total: number; icon: string; color: string }> = {
      'Hiring Pipeline': { total: 8, icon: '󰓾', color: 'var(--accent-green)' },
      'Start Here': { total: 3, icon: '', color: 'var(--accent-orange)' },
      'Foundations': { total: 6, icon: '', color: 'var(--accent-blue)' },
      'Role Roadmaps': { total: Math.max(8, ROADMAP_TOTAL), icon: '', color: 'var(--accent-purple)' },
      'Interviews': { total: 10, icon: '', color: 'var(--accent-red)' },
      'System Design': { total: 4, icon: '', color: 'var(--accent-teal)' },
      'ML & MLOps': { total: 6, icon: '', color: 'var(--accent-pink)' },
      'Data': { total: 6, icon: '', color: 'var(--accent-sky)' },
      'Infra & DevOps': { total: 6, icon: '', color: 'var(--accent-yellow)' },
      'Career': { total: 6, icon: '', color: 'var(--accent-mauve)' },
      'Company Notes': { total: 6, icon: '', color: 'var(--accent-flamingo)' },
    };

    let totalCompleted = 0;
    let totalTopics = 0;
    let percentages: number[] = [];

    let html = '';
    for (const [section, data] of Object.entries(sections)) {
      let completed = topicsBySection[section] || 0;
      if (section === 'Role Roadmaps') completed = ROADMAP_DONE;
      const percentage = Math.round((completed / data.total) * 100);
      
      totalCompleted += completed;
      totalTopics += data.total;
      percentages.push(percentage);

      html += `
        <div class="progress-bar-item" data-section="${section}" data-tooltip="${completed}/${data.total} topics completed">
          <div class="progress-bar-label">
            <span class="section-icon">${data.icon}</span>
            ${section}
          </div>
          <div class="progress-bar-container">
            <div class="progress-bar-fill" style="width: ${percentage}%; background: linear-gradient(90deg, ${data.color}dd, ${data.color}88);">${percentage}%</div>
          </div>
          <div class="progress-bar-percent">${completed}/${data.total}</div>
        </div>
      `;
    }
    container.innerHTML = html;

    // Update overview stats
    const avgProgress = percentages.length > 0 ? Math.round(percentages.reduce((a, b) => a + b, 0) / percentages.length) : 0;
    const remaining = totalTopics - totalCompleted;
    
    document.getElementById('avg-progress')!.textContent = avgProgress.toString();
    document.getElementById('total-topics')!.textContent = totalCompleted.toString();
    document.getElementById('completed-topics')!.textContent = totalCompleted.toString();
    document.getElementById('remaining-topics')!.textContent = remaining.toString();
    document.getElementById('overall-percent')!.textContent = `${avgProgress}%`;
    
    // Update donut chart
    const circumference = 2 * Math.PI * 52;
    const offset = circumference - (avgProgress / 100) * circumference;
    const donutFill = document.getElementById('overall-progress') as SVGCircleElement;
    if (donutFill) {
      donutFill.style.strokeDashoffset = offset.toString();
    }

    // Generate insights
    updateInsights(topicsBySection, sections, avgProgress, totalCompleted);
  }

  function updateInsights(topicsBySection: Record<string, number>, sections: any, avgProgress: number, totalCompleted: number) {
    const container = document.getElementById('progress-insights');
    if (!container) return;

    const insights: { type: 'positive' | 'warning' | 'info'; icon: string; title: string; description: string }[] = [];

    // Find strongest section
    let strongestSection = '';
    let strongestPercent = 0;
    for (const [section, data] of Object.entries(sections)) {
      const completed = topicsBySection[section] || 0;
      const percent = (completed / data.total) * 100;
      if (percent > strongestPercent) {
        strongestPercent = percent;
        strongestSection = section;
      }
    }

    // Find weakest section
    let weakestSection = '';
    let weakestPercent = 100;
    for (const [section, data] of Object.entries(sections)) {
      const completed = topicsBySection[section] || 0;
      const percent = (completed / data.total) * 100;
      if (percent < weakestPercent && percent >= 0) {
        weakestPercent = percent;
        weakestSection = section;
      }
    }

    // Generate insights
    if (strongestSection && strongestPercent > 50) {
      insights.push({
        type: 'positive',
        icon: '',
        title: 'Strongest Section',
        description: `You're doing great in <strong>${strongestSection}</strong> with ${Math.round(strongestPercent)}% completion!`,
      });
    }

    if (weakestSection && weakestPercent < 20) {
      insights.push({
        type: 'warning',
        icon: '',
        title: 'Needs Attention',
        description: `Consider spending more time on <strong>${weakestSection}</strong> to improve your overall progress.`,
      });
    }

    if (avgProgress < 30 && totalCompleted > 0) {
      insights.push({
        type: 'info',
        icon: '',
        title: 'Keep Going!',
        description: 'You\'ve made a start! Try to complete at least 1 topic per day to build momentum.',
      });
    }

    if (totalCompleted === 0) {
      insights.push({
        type: 'info',
        icon: '',
        title: 'Getting Started',
        description: 'Start with the <strong>Start Here</strong> section to get oriented with the roadmap.',
      });
    }

    if (insights.length === 0) {
      insights.push({
        type: 'positive',
        icon: '',
        title: 'Excellent Progress!',
        description: 'You\'re on track! Keep maintaining your study schedule to reach your goals.',
      });
    }

    let html = '';
    for (const insight of insights) {
      html += `
        <div class="insight-item ${insight.type}">
          <span class="nf insight-icon">${insight.icon}</span>
          <div class="insight-content">
            <div class="insight-title">${insight.title}</div>
            <div class="insight-description">${insight.description}</div>
          </div>
        </div>
      `;
    }
    container.innerHTML = html;
  }

  function updateActivityCalendar(dates: string[]) {
    const container = document.querySelector('.calendar-grid');
    if (!container) return;

    const dateSet = new Set(dates);
    const today = new Date();
    let html = '';
    
    for (let i = 29; i >= 0; i--) {
      const date = new Date(today);
      date.setDate(date.getDate() - i);
      const dateStr = date.toISOString().split('T')[0];
      
      const active = dateSet.has(dateStr);
      const intensity = active ? 2 : 0;
      
      html += `<div class="calendar-day ${intensity > 0 ? `active-${intensity}` : ''}" title="${dateStr}: ${active ? 'study day' : 'no study'}"></div>`;
    }
    
    container.innerHTML = html;
  }

  function renderStreakChart(dates: string[]) {
    const container = document.getElementById('streak-chart');
    if (!container) return;

    document.getElementById('streak-current')!.textContent = computeStreak(dates).toString();

    const dateSet = new Set(dates);
    const dayMs = 86400000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // Best streak
    let best = 0;
    let run = 0;
    let prev: Date | null = null;
    for (const d of dateSet) {
      const parsed = new Date(d + 'T00:00:00');
      if (prev && parsed.getTime() - prev.getTime() === dayMs) run++;
      else run = 1;
      if (run > best) best = run;
      prev = parsed;
    }
    document.getElementById('streak-best')!.textContent = best.toString();
    document.getElementById('streak-days')!.textContent = dates.length.toString();

    // 12-week grid: columns = weeks, rows = Mon..Sun
    const end = new Date(today);
    const start = new Date(end);
    start.setDate(start.getDate() - (84 - 1));

    // Shift so columns start on Monday
    const mondayOffset = (start.getDay() + 6) % 7;
    start.setDate(start.getDate() - mondayOffset);

    let html = '';
    const rows = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const weekCount = Math.ceil((end.getTime() - start.getTime()) / dayMs / 7);

    for (let w = 0; w < weekCount; w++) {
      html += '<div class="streak-week">';
      for (let d = 0; d < 7; d++) {
        const cell = new Date(start.getTime() + (w * 7 + d) * dayMs);
        const dateStr = cell.toISOString().split('T')[0];
        const active = dateSet.has(dateStr);
        const isFuture = cell.getTime() > today.getTime();
        const label = isFuture
          ? dateStr + ' (future)'
          : `${dateStr}: ${active ? 'study day' : 'no study'}`;
        html += `<div class="streak-day ${active ? 'active' : ''} ${isFuture ? 'future' : ''}" title="${label}"></div>`;
      }
      html += '</div>';
    }

    container.innerHTML = html;
  }

  function updateRecentActivity(sessions: any[]) {
    const container = document.getElementById('recent-activity');
    if (!container) return;

    if (sessions.length === 0) {
      container.innerHTML = `
        <div class="activity-empty">
          <span class="nf"></span>
          <p>No recent activity yet</p>
          <span>Start studying to see your progress!</span>
        </div>
      `;
      return;
    }

    const recent = sessions.slice(-10).reverse();
    let html = '';
    
    for (const session of recent) {
      html += `
        <div class="activity-item">
          <span class="nf"></span>
          <div class="activity-item-content">
            <div class="activity-item-title">${session.topic}</div>
            <div class="activity-item-meta">${session.section} • ${session.duration} min • ${session.date}</div>
          </div>
        </div>
      `;
    }
    
    container.innerHTML = html;
  }

  function updateAchievements(unlockedIds: string[]) {
    const container = document.getElementById('achievements-grid');
    if (!container) return;

    const allAchievements = [
      { id: 'first-topic', name: 'First Step', description: 'Complete your first topic', icon: '' },
      { id: 'week-streak', name: 'Week Warrior', description: '7 day study streak', icon: '' },
      { id: 'month-streak', name: 'Month Master', description: '30 day study streak', icon: '' },
      { id: '10-topics', name: 'Dedicated Learner', description: 'Complete 10 topics', icon: '' },
      { id: '25-topics', name: 'Knowledge Seeker', description: 'Complete 25 topics', icon: '' },
      { id: '50-topics', name: 'Interview Ready', description: 'Complete 50 topics', icon: '' },
      { id: '100-hours', name: 'Century Club', description: '100 hours of study', icon: '' },
      { id: 'first-app', name: 'Job Seeker', description: 'Track your first application', icon: '' },
      { id: '10-problems', name: 'Problem Solver', description: 'Solve 10 LeetCode problems', icon: '󰅖' },
      { id: '25-problems', name: 'Grinder', description: 'Solve 25 LeetCode problems', icon: '󰅖' },
      { id: '50-problems', name: 'Pattern Master', description: 'Solve 50 LeetCode problems', icon: '󰆮' },
      { id: '100-problems', name: 'Century Problem', description: 'Solve 100 LeetCode problems', icon: '󰆮' },
    ];
    
    let html = '';
    for (const achievement of allAchievements) {
      const unlocked = unlockedIds.includes(achievement.id);
      html += `
        <div class="achievement-card ${unlocked ? 'unlocked' : ''}">
          <div class="achievement-icon">${achievement.icon}</div>
          <div class="achievement-name">${achievement.name}</div>
          <div class="achievement-description">${achievement.description}</div>
        </div>
      `;
    }
    
    container.innerHTML = html;
  }

  function renderRoadmapProgress() {
    const container = document.getElementById('rm-dashboard-grid');
    if (!container) return;

    const summaryEl = document.getElementById('rm-dashboard-summary');
    const summary = summaryEl
      ? JSON.parse(summaryEl.textContent || '[]')
      : [];

    let saved: Record<string, Record<string, string>> = {};
    try {
      saved = JSON.parse(localStorage.getItem('rm-progress') || '{}');
    } catch {
      saved = {};
    }

    let totalPct = 0;
    ROADMAP_DONE = 0;
    ROADMAP_TOTAL = 0;
    let html = '';
    for (const rm of summary) {
      const state = saved[rm.slug] || {};
      let done = 0;
      let doing = 0;
      for (const v of Object.values(state)) {
        if (v === 'done') done++;
        else if (v === 'doing') doing++;
      }
      const pct = rm.total ? Math.round(((done + doing * 0.5) / rm.total) * 100) : 0;
      totalPct += pct;
      ROADMAP_DONE += done;
      ROADMAP_TOTAL += rm.total;

      html += `
        <a class="rm-dashboard-card" href="/roadmap/${rm.slug}">
          <div class="rm-dashboard-card-top">
            <span class="rm-dashboard-name">${rm.name}</span>
            <span class="rm-dashboard-pct">${pct}%</span>
          </div>
          <div class="rm-dashboard-bar">
            <div class="rm-dashboard-fill" style="width: ${pct}%"></div>
          </div>
          <div class="rm-dashboard-meta">
            <span>${done} done</span>
            <span>${doing} in progress</span>
            <span>${rm.total} topics</span>
          </div>
        </a>
      `;
    }

    container.innerHTML = html;
    if (summary.length > 0) {
      document.getElementById('rm-dashboard-avg')!.textContent =
        Math.round(totalPct / summary.length).toString();
    }
  }

  function renderNextActions() {
    const container = document.getElementById('next-actions');
    if (!container) return;

    const summaryEl = document.getElementById('rm-dashboard-summary');
    const summary = summaryEl
      ? JSON.parse(summaryEl.textContent || '[]')
      : [];

    let saved: Record<string, Record<string, string>> = {};
    try {
      saved = JSON.parse(localStorage.getItem('rm-progress') || '{}');
    } catch {
      saved = {};
    }

    const roleStats = summary.map((rm: any) => {
      const state = saved[rm.slug] || {};
      let done = 0;
      let doing = 0;
      const phaseStats = rm.phases.map((p: any) => {
        let pdone = 0;
        for (const id of p.nodes) {
          const s = state[id];
          if (s === 'done') {
            pdone++;
            done++;
          } else if (s === 'doing') doing++;
        }
        return { name: p.name, done: pdone, total: p.nodes.length };
      });
      const pct = rm.total ? Math.round(((done + doing * 0.5) / rm.total) * 100) : 0;
      return { slug: rm.slug, name: rm.name, done, doing, total: rm.total, pct, phaseStats };
    });

    const started = roleStats.filter((r: any) => r.pct > 0);
    const unstarted = roleStats.filter((r: any) => r.pct === 0);
    const actions: {
      icon: string;
      cls: string;
      title: string;
      desc: string;
      href: string;
    }[] = [];

    if (roleStats.length === 0 || started.length === 0) {
      actions.push({
        icon: '󰘓',
        cls: 'primary',
        title: 'Pick your first roadmap',
        desc: 'Take the 30-second role quiz or start a track',
        href: '/roadmap',
      });
    } else {
      const doingRoles = [...started].sort((a: any, b: any) => b.doing - a.doing);
      const r = doingRoles[0];
      if (r && r.doing > 0) {
        actions.push({
          icon: '󰫑',
          cls: 'primary',
          title: `Finish ${r.doing} in-progress topics`,
          desc: `${r.name}: pick up where you left off`,
          href: `/roadmap/${r.slug}`,
        });
      }

      const weakest = started
        .flatMap((s: any) =>
          s.phaseStats.map((p: any) => ({
            role: s,
            phase: p,
            ratio: p.total ? p.done / p.total : 0,
          })),
        )
        .sort((a: any, b: any) => a.ratio - b.ratio)[0];
      if (weakest && weakest.phase.done < weakest.phase.total) {
        const remaining = weakest.phase.total - weakest.phase.done;
        actions.push({
          icon: '󰦨',
          cls: 'warning',
          title: `Attack your weakest phase: ${weakest.phase.name}`,
          desc: `${weakest.role.name} · ${remaining} topics left in this phase`,
          href: `/roadmap/${weakest.role.slug}`,
        });
      }

      if (unstarted.length > 0) {
        actions.push({
          icon: '󰒓',
          cls: 'info',
          title: `Start a new roadmap (${unstarted.length} untouched)`,
          desc: `Try ${unstarted[0].name} next`,
          href: '/roadmap',
        });
      }

      const firstStarted = started[0];
      actions.push({
        icon: '',
        cls: 'plan',
        title: 'Plan your week',
        desc: `Generate a study plan from your ${firstStarted.name} gaps`,
        href: `/roadmap/${firstStarted.slug}`,
      });
    }

    container.innerHTML = actions
      .slice(0, 4)
      .map(
        (a) => `
        <a class="next-action ${a.cls}" href="${a.href}">
          <span class="next-action-icon"><span class="nf">${a.icon}</span></span>
          <span class="next-action-body">
            <span class="next-action-title">${a.title}</span>
            <span class="next-action-desc">${a.desc}</span>
          </span>
          <span class="nf next-action-arrow"></span>
        </a>`,
      )
      .join('');
  }

  function renderWeeklyDigest() {
    const chartEl = document.getElementById('digest-chart');
    if (!chartEl) return;

    let log: { date: string; id: string; title: string; role: string }[] = [];
    try {
      log = JSON.parse(localStorage.getItem('rm-log') || '[]');
    } catch { /* ignore */ }

    const dayMs = 86400000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const thisWeek = new Array(7).fill(0); // index 0 = 6 days ago .. 6 = today
    let topicsThisWeek = 0;
    let daysThisWeek = 0;
    const daysThisWeekSet = new Set<string>();

    const weekAgo = new Date(today.getTime() - 6 * dayMs);
    const twoWeeksAgo = new Date(today.getTime() - 13 * dayMs);

    let topicsLastWeek = 0;
    const daysLastWeekSet = new Set<string>();

    for (const entry of log) {
      const t = new Date(entry.date + 'T00:00:00').getTime();
      if (t >= weekAgo.getTime() && t <= today.getTime()) {
        topicsThisWeek++;
        daysThisWeekSet.add(entry.date);
        const idx = Math.round((today.getTime() - t) / dayMs);
        thisWeek[6 - idx]++;
      } else if (t >= twoWeeksAgo.getTime() && t < weekAgo.getTime()) {
        topicsLastWeek++;
        daysLastWeekSet.add(entry.date);
      }
    }
    daysThisWeek = daysThisWeekSet.size;

    // Total topics ever completed (dedupe by id)
    const seen = new Set<string>();
    let topicsTotal = 0;
    for (const entry of log) {
      if (!seen.has(entry.id)) {
        seen.add(entry.id);
        topicsTotal++;
      }
    }

    document.getElementById('digest-topics-week')!.textContent = topicsThisWeek.toString();
    document.getElementById('digest-days-week')!.textContent = daysThisWeek.toString();
    document.getElementById('digest-topics-total')!.textContent = topicsTotal.toString();

    const setDelta = (id: string, now: number, before: number, invert = false) => {
      const el = document.getElementById(id);
      if (!el) return;
      const diff = now - before;
      const good = invert ? diff < 0 : diff > 0;
      const arrow = diff > 0 ? '' : diff < 0 ? '' : '';
      const cls = diff === 0 ? 'flat' : good ? 'up' : 'down';
      const label = diff === 0 ? 'same as last week' : `${Math.abs(diff)} ${diff > 0 ? 'more' : 'fewer'} than last week`;
      el.innerHTML = `<span class="nf">${arrow}</span> <span class="digest-delta-text">${label}</span>`;
      el.className = `digest-delta ${cls}`;
    };
    setDelta('digest-topics-delta', topicsThisWeek, topicsLastWeek);
    setDelta('digest-days-delta', daysThisWeekSet.size, daysLastWeekSet.size);

    const maxBar = Math.max(1, ...thisWeek);
    const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

    const goal = (loadFromStorage<ProgressData>(STORAGE_KEYS.PROGRESS) || {}).weeklyGoal || 0;
    const goalPct = goal ? Math.min(100, Math.round((topicsThisWeek / goal) * 100)) : 0;
    const goalHtml = goal
      ? `<div class="digest-goal">
          <span class="digest-goal-label">Goal: ${topicsThisWeek}/${goal} topics this week</span>
          <span class="digest-goal-bar"><span class="digest-goal-fill ${goalPct >= 100 ? 'done' : ''}" style="width:${goalPct}%"></span></span>
          <span class="digest-goal-pct">${goalPct}%</span>
        </div>`
      : '';

    chartEl.innerHTML = `${goalHtml}
      <div class="digest-chart-bars">
        ${thisWeek
          .map((count, i) => {
            const date = new Date(today.getTime() - (6 - i) * dayMs);
            const isToday = i === 6;
            const pct = Math.round((count / maxBar) * 100);
            return `<div class="digest-bar-col" title="${date.toISOString().split('T')[0]}: ${count} topic${count === 1 ? '' : 's'}">
              <div class="digest-bar-track"><div class="digest-bar-fill" style="height:${Math.max(4, pct)}%"></div></div>
              <div class="digest-bar-day">${dayNames[date.getDay()]}${isToday ? '·today' : ''}</div>
            </div>`;
          })
          .join('')}
      </div>`;
  }

  function renderLeetCodeProgress(stats: { solved: number; byCompany: Record<string, number> }) {
    const container = document.getElementById('lc-grid');
    if (!container) return;

    document.getElementById('lc-solved-total')!.textContent = stats.solved.toString();

    if (stats.solved === 0) {
      container.innerHTML = '<p class="empty-state">No solved problems yet — check off problems on any company page to track them here.</p>';
      return;
    }

    // LeetCode companies with solved problems (from storage keys)
    const rows = Object.entries(stats.byCompany)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 12)
      .map(([company, count]) => {
        const name = company === 'facebook' ? 'Meta' : company.charAt(0).toUpperCase() + company.slice(1);
        return `<a class="lc-row" href="/leetcode/${company}">
          <span class="lc-company">${name}</span>
          <span class="lc-bar"><span class="lc-fill" style="width:${Math.min(100, count * 10)}%"></span></span>
          <span class="lc-count">${count} solved</span>
        </a>`;
      })
      .join('');

    container.innerHTML = `<div class="lc-list">${rows}</div>`;
  }

  function renderBackupStatus() {
    const el = document.getElementById('backup-status');
    if (!el) return;
    try {
      const last = localStorage.getItem('faang-last-backup');
      if (!last) {
        el.textContent = 'Never backed up';
        el.classList.add('warn');
        return;
      }
      const days = Math.floor((Date.now() - new Date(last).getTime()) / 86400000);
      el.textContent = days <= 0 ? 'Backed up today' : `Backed up ${days}d ago`;
      el.classList.toggle('warn', days >= 7);
    } catch { /* ignore */ }
  }

  function backupKeys(): string[] {
    const known = ['rm-progress', 'rm-notes', 'rm-activity', 'rm-log', 'faang-progress', 'faang-study-plans', 'faang-applications', 'faang-questions', 'faang-roadmap-progress', 'faang-last-backup'];
    const keys = [...known];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && (key.startsWith('topic-') || key.startsWith('leetcode-'))) keys.push(key);
      }
    } catch { /* ignore */ }
    return keys;
  }

  document.getElementById('backup-export')?.addEventListener('click', () => {
    const payload: Record<string, any> = { exportedAt: new Date().toISOString(), data: {} };
    for (const key of backupKeys()) {
      try {
        const raw = localStorage.getItem(key);
        if (raw !== null) payload.data[key] = JSON.parse(raw);
      } catch { /* ignore */ }
    }
    localStorage.setItem('faang-last-backup', new Date().toISOString());
    renderBackupStatus();
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `faang-backup-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
    alert('Backup exported. Restore anytime with "Restore from backup".');
  });

  const backupInput = document.getElementById('backup-import-input') as HTMLInputElement | null;
  document.getElementById('backup-import')?.addEventListener('click', () => backupInput?.click());

  backupInput?.addEventListener('change', () => {
    const file = backupInput.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const parsed = JSON.parse(String(reader.result));
        const data = parsed?.data && typeof parsed.data === 'object' ? parsed.data : parsed;
        let count = 0;
        for (const [key, value] of Object.entries(data)) {
          localStorage.setItem(key, JSON.stringify(value));
          count++;
        }
        alert(`Restored ${count} keys. Reloading…`);
        location.reload();
      } catch {
        alert('Invalid backup file.');
      }
    };
    reader.readAsText(file);
    backupInput.value = '';
  });

  // Weekly goal
  const goalInput = document.getElementById('weekly-goal') as HTMLInputElement | null;
  if (goalInput) {
    const progress = loadFromStorage<ProgressData>(STORAGE_KEYS.PROGRESS) || {};
    if (progress.weeklyGoal) goalInput.value = progress.weeklyGoal.toString();
    goalInput.addEventListener('change', () => {
      const value = parseInt(goalInput.value, 10);
      if (!value || value < 1 || value > 50) { goalInput.value = ''; return; }
      const p = loadFromStorage<ProgressData>(STORAGE_KEYS.PROGRESS) || {};
      p.weeklyGoal = value;
      saveToStorage(STORAGE_KEYS.PROGRESS, p);
      renderWeeklyDigest();
    });
  }

  // Unified progress sync toggle
  const unifiedToggle = document.getElementById('unified-toggle') as HTMLInputElement | null;
  if (unifiedToggle) {
    try {
      const progress = JSON.parse(localStorage.getItem('faang-progress') || '{}');
      unifiedToggle.checked = progress.unifiedProgress === true;
    } catch { /* ignore */ }
    unifiedToggle.addEventListener('change', () => {
      try {
        const progress = JSON.parse(localStorage.getItem('faang-progress') || '{}');
        progress.unifiedProgress = unifiedToggle.checked;
        localStorage.setItem('faang-progress', JSON.stringify(progress));
      } catch { /* ignore */ }
    });
  }

  renderRoadmapProgress();

  loadDashboard();

  // Reset progress button
  document.getElementById('reset-progress')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to reset all progress? This cannot be undone!')) {
      localStorage.removeItem(STORAGE_KEYS.PROGRESS);
      location.reload();
    }
  });
</script>
